{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "buyer": {
      "root": "buyer",
      "framework": "nextjs"
    },
    "seller": {
      "root": "seller",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/sell", "destination": { "service": "seller" } },
    { "source": "/sell/(.*)", "destination": { "service": "seller" } },
    { "source": "/(.*)", "destination": { "service": "buyer" } }
  ]
}
