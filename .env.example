# Mint: ONE .env for the whole repo, in the repo root (gitignored). Copy this file to .env and fill in what you need.
# Never commit .env or paste keys in chat. Backend keys reach Modal with:  python gsplat/push_secrets.py
# Every part reads this file: gsplat/ (push_secrets.py), listing/, multiagent/buyer_agent, buyer/ and seller/.

# --- Supabase, project "mint" (dashboard -> Settings -> API) ------------------------------------------------
SUPABASE_URL=https://jpanyhsifoxxiizkgjno.supabase.co
# Server only: goes into the Modal secret mint-supabase. Never in a web or iOS app.
SUPABASE_SERVICE_ROLE_KEY=
# Public values for the web apps (the anon key is designed to be public; reads are limited by bucket rules).
NEXT_PUBLIC_SUPABASE_URL=https://jpanyhsifoxxiizkgjno.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, never on Modal or in an app: a personal access token (dashboard -> Account -> Access Tokens) lets
# supabase_setup/deploy.py deploy the Edge Functions and run webhook.sql without dashboard clicks.
SUPABASE_ACCESS_TOKEN=

# --- Listing pipeline (listing/, Jev + Gemini). Also the Modal secret mint-listing ------------------------
TYPESAFE_API_KEY=
GEMINI_API_KEY=
# listing/'s Gemini model. Free tier (AI Studio -> Rate Limit): gemini-3.5-flash-lite 500 requests/day (~160 listings),
# the Flash models only 20/day (~6 listings). Demo day: switch to gemini-3.5-flash (or keep lite and enable billing),
# then python gsplat/push_secrets.py && modal deploy gsplat/app.py. gemini-3.8-flash timed out (90 s, 2026-10-17).
GEMINI_MODEL=gemini-3.5-flash-lite
# Image search for the baseline photo
SERPER_API_KEY=
# Where listing/ renders when run on a laptop: modal | local
RENDER_BACKEND=modal

# --- Buyer agent (multiagent/buyer_agent); also uses TYPESAFE_API_KEY ---------------------------------------
GROQ_API_KEY=
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
BUYER_AGENT_TOKEN=
DATA_ROOT=
BUYER_AGENT_LIVE=
BUYER_AGENT_RENDERER_VALIDATED=

# --- Web apps (buyer/, seller/), optional ----------------------------------------------------------------------
# 0 hides live scans on the buyer site
MINT_LIVE_LISTINGS=
# Where the seller site links "See it on Mint" (the buyer site)
NEXT_PUBLIC_BUYER_URL=http://localhost:3000
# The deep link the seller site's QR code opens on the iPhone (the Mint app registers the mint:// scheme)
NEXT_PUBLIC_MINT_SCAN_LINK=mint://scan
