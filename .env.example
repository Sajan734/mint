# Mint: ONE .env for the whole repo, in the repo root (gitignored). Copy this file to .env and fill in what you need.
# Never commit .env or paste keys in chat. `modal deploy gsplat/app.py` sends the backend keys with the app.
# Every part reads this file: gsplat/, supabase_setup/, listing/, multiagent/buyer_agent, buyer/ and seller/.

# --- Modal (modal.com -> Settings -> API Tokens): the workspace every deploy and Modal call goes to. The live one is
# abhinavdave2020. To use someone else's Modal, put their token here, then:
# modal deploy gsplat/app.py && python gsplat/client.py urls
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Supabase, project "mint" (dashboard -> Settings -> API) ------------------------------------------------
SUPABASE_URL=https://jpanyhsifoxxiizkgjno.supabase.co
# Server only: sent to Modal with the deploy. Never in a web or iOS app.
SUPABASE_SERVICE_ROLE_KEY=
# Public values for the web apps (the anon key is designed to be public; reads are limited by bucket rules).
NEXT_PUBLIC_SUPABASE_URL=https://jpanyhsifoxxiizkgjno.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, never on Modal or in an app: a personal access token (dashboard -> Account -> Access Tokens) lets
# supabase_setup/deploy.py deploy the Edge Functions and run webhook.sql without dashboard clicks.
SUPABASE_ACCESS_TOKEN=

# --- Listing pipeline (listing/, Jev + Gemini). Sent to Modal with the deploy ------------------------------
TYPESAFE_API_KEY=
GEMINI_API_KEY=
# (The Gemini model is set in listing/stages/identify.py; a GEMINI_MODEL here is ignored.)
# Image search for the baseline photo
SERPER_API_KEY=

# --- Buyer agent (multiagent/buyer_agent); also uses TYPESAFE_API_KEY. Sent to Modal with the deploy ------
GROQ_API_KEY=
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
BUYER_AGENT_TOKEN=
DATA_ROOT=
BUYER_AGENT_LIVE=
BUYER_AGENT_RENDERER_VALIDATED=

# --- Web apps (buyer/, seller/), optional ----------------------------------------------------------------------
# 0 hides live scans on the buyer site
MINT_LIVE_LISTINGS=
# Where the seller site links "See it on Mint" (the buyer site)
NEXT_PUBLIC_BUYER_URL=http://localhost:3000
# The website's write path (Publish): gsplat/app.py `api` on Modal. `python gsplat/client.py urls` fills it in.
NEXT_PUBLIC_MINT_API_URL=
# The deep link the seller site's QR code opens on the iPhone (the Mint app registers the mint:// scheme)
NEXT_PUBLIC_MINT_SCAN_LINK=mint://scan
